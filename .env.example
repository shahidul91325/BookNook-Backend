# Copy this file to .env and fill in the real values. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (keep this secret!)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/booknook?retryWrites=true&w=majority
# For a local standalone mongod, use:
# MONGODB_URI=mongodb://localhost:27017/booknook?retryWrites=false

# Database name used by the API and Better Auth collections.
MONGODB_DB_NAME=booknook

# Better Auth server secret. Keep this only on the Express server (min 32 chars).
BETTER_AUTH_SECRET=<32+ character high-entropy value>

# Canonical public auth URL, including the standard mount path. CORS and JWT
# issuer/audience values are derived from its origin/value by the backend.
BETTER_AUTH_URL=http://localhost:3000/api/auth

# Direct Express JWKS endpoint used for backend JWT verification.
JWT_JWKS_URL=http://localhost:5000/api/auth/jwks

# Google OAuth client registered with the frontend callback URL:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# ── Rate limiting (optional — these are the defaults) ──────────────────────
# Window length in milliseconds for all rate-limit buckets.
#RATE_LIMIT_WINDOW_MS=60000
# Max requests per client IP per window, all endpoints combined.
#RATE_LIMIT_MAX=300
# Max WRITE requests (create/update/delete/borrow/return) per client IP
# per window — the stricter budget for sensitive endpoints.
#RATE_LIMIT_WRITE_MAX=60

# Reverse proxy hops in front of the API. Leave at 0 when the server is
# exposed directly. Set to 1 ONLY behind a trusted proxy (nginx, load
# balancer) so rate limiting sees real client IPs — on a directly exposed
# server, trusting X-Forwarded-For would let clients spoof their IP.
#TRUST_PROXY=0
