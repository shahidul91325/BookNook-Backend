# Copy this file to .env and fill in the real values. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (keep this secret!)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/booknook?retryWrites=true&w=majority

# Database name — MUST match the frontend's MONGODB_DB_NAME, because the
# Better Auth collections (user, session, account, verification) live here.
DB_NAME=booknook

# Allowed CORS origin(s) — your Next.js frontend, comma separated
CORS_ORIGIN=http://localhost:3000

# Better Auth signing secret — MUST be byte-identical to the frontend's
# BETTER_AUTH_SECRET (Next.js .env.local). Session cookies are HMAC-SHA256
# signed with it; a mismatch makes every request fail with 401. Min 32 chars.
BETTER_AUTH_SECRET=<same value as the frontend .env.local>
