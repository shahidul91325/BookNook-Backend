{
  "name": "booknook-server",
  "version": "1.0.0",
  "private": true,
  "description": "BookNook Backend — Express + MongoDB + Better Auth API",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "verify:models": "tsx scripts/verify-data-models.ts",
    "verify:auth": "tsx scripts/verify-auth.ts",
    "verify:books": "tsx scripts/verify-books.ts",
    "verify:create": "npm run verify:integration",
    "verify:manage": "npm run verify:integration",
    "verify:borrows": "npm run verify:integration",
    "verify:integration": "tsx scripts/verify-integration.ts",
    "verify:security": "npm run verify:integration",
    "verify": "npm run build && npm run verify:models && npm run verify:auth && npm run verify:integration"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "better-auth": "^1.7.14",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jose": "^6.2.15",
    "mongodb": "^7.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vercel": "^65.9.0"
  }
}
